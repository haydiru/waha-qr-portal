# ==============================================================================
# WAHA SENTINEL GATEWAY — CONFIGURATION TEMPLATE
# ==============================================================================

# Server Listening Port
PORT=3000
NODE_ENV=production

# WAHA Core Connection (Internal Docker DNS)
# Inside Coolify network, target WAHA service by its container name (e.g. http://waha:3000)
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=your_waha_api_key_here
WAHA_SESSION=default

# Perimeter Security Layer 1: Cryptographic URL Query Token (?auth=...)
SECRET_AUTH_TOKEN=SEC_9f4b29a17c0e8281d4e38c92a11b058a

# Perimeter Security Layer 2: 6-Digit Segmented Numeric Master PIN
MASTER_PIN=123456

# Phone Whitelist Guard (Optional, comma-separated digits)
# Example: 628118899201,628123456789
# If set, any unauthorized WhatsApp account that scans the QR will be automatically logged out!
ALLOWED_PHONE_NUMBER=

# Cookie Signature Secret (Random 32+ characters)
SESSION_SECRET=c28f09d8e7b1a23c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c
